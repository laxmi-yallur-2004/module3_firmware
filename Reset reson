#include <LiquidCrystal.h>
#include <EEPROM.h>
#include <avr/wdt.h>
#include <avr/io.h>

// ==================================================
// LCD
// ==================================================

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

// ==================================================
// EEPROM
// ==================================================

#define FAULT_ADDR 0

// ==================================================
// FAULT
// ==================================================

#define SENSOR_FAULT 101

// ==================================================
// RESET FLAGS FROM OPTIBOOT
// ==================================================

uint8_t resetFlag __attribute__((section(".noinit")));

// ==================================================
// COPY RESET FLAGS FROM R2
// ==================================================

void resetFlagsInit(void)
  __attribute__((naked))
  __attribute__((used))
  __attribute__((section(".init0")));

void resetFlagsInit(void)
{
  __asm__ __volatile__(
    "sts %0, r2\n"
    :
    : "m" (resetFlag)
  );
}

// ==================================================
// VARIABLES
// ==================================================

unsigned long startTime = 0;

uint8_t stage = 0;

// ==================================================
// SETUP
// ==================================================

void setup()
{
  // --------------------------------------------------
  // Disable watchdog safely
  // --------------------------------------------------

  MCUSR = 0;
  wdt_disable();

  // --------------------------------------------------
  // LCD
  // --------------------------------------------------

  lcd.begin(16, 2);

  // --------------------------------------------------
  // Serial
  // --------------------------------------------------

  Serial.begin(9600);

  // --------------------------------------------------
  // Read saved fault
  // --------------------------------------------------

  int fault;

  EEPROM.get(FAULT_ADDR, fault);

  // ==================================================
  // HEADER
  // ==================================================

  Serial.println();
  Serial.println("==============================");
  Serial.println("        MODULE 4");
  Serial.println("==============================");

  // ==================================================
  // CHECK RESET FLAG PASSED BY OPTIBOOT
  // ==================================================

  if (resetFlag & (1 << WDRF))
  {
    // ==================================================
    // WATCHDOG RESET
    // ==================================================

    Serial.println("RESET STATUS");
    Serial.println("MCUSR -> WDRF");
    Serial.println("WDRF = 1");
    Serial.println("Reset Reason: WATCHDOG");

    // --------------------------------------------------
    // LCD
    // --------------------------------------------------

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("RESET:");

    lcd.setCursor(0, 1);
    lcd.print("WATCHDOG");

    startTime = millis();

    stage = 2;
  }
  else
  {
    // ==================================================
    // NORMAL POWER ON
    // ==================================================

    Serial.println("RESET STATUS");
    Serial.println("MCUSR -> WDRF");
    Serial.println("WDRF = 0");
    Serial.println("Reset Reason: POWER ON");

    // --------------------------------------------------
    // Sensor fault
    // --------------------------------------------------

    fault = SENSOR_FAULT;

    EEPROM.put(FAULT_ADDR, fault);

    Serial.println("Sensor Fault Detected");
    Serial.println("Saving Fault Code: 101");

    // --------------------------------------------------
    // LCD
    // --------------------------------------------------

    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("FAULT SAVED");

    lcd.setCursor(0, 1);
    lcd.print("CODE: 101");

    startTime = millis();

    stage = 1;
  }
}

// ==================================================
// LOOP
// ==================================================

void loop()
{
  unsigned long currentTime = millis();

  // ==================================================
  // STAGE 1
  // POWER ON
  // ==================================================

  if (stage == 1)
  {
    if (currentTime - startTime >= 2000)
    {
      // ------------------------------------------------
      // LCD
      // ------------------------------------------------

      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("WATCHDOG");

      lcd.setCursor(0, 1);
      lcd.print("STARTING...");

      // ------------------------------------------------
      // SERIAL
      // ------------------------------------------------

      Serial.println();
      Serial.println("Starting Watchdog");
      Serial.println("Timeout: 1 second");

      Serial.flush();

      // ------------------------------------------------
      // Enable watchdog
      // ------------------------------------------------

      wdt_enable(WDTO_1S);

      // ------------------------------------------------
      // Wait for watchdog reset
      // ------------------------------------------------

      while (1)
      {
      }
    }
  }

  // ==================================================
  // STAGE 2
  // WATCHDOG RECOVERY
  // ==================================================

  else if (stage == 2)
  {
    if (currentTime - startTime >= 2000)
    {
      int fault;

      EEPROM.get(FAULT_ADDR, fault);

      // ------------------------------------------------
      // LCD
      // ------------------------------------------------

      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("LAST FAULT:");

      lcd.setCursor(0, 1);
      lcd.print(fault);

      // ------------------------------------------------
      // SERIAL
      // ------------------------------------------------

      Serial.println();
      Serial.println("WATCHDOG RECOVERY");

      Serial.print("Last Fault Code: ");
      Serial.println(fault);

      startTime = currentTime;

      stage = 3;
    }
  }

  // ==================================================
  // STAGE 3
  // COMPLETE
  // ==================================================

  else if (stage == 3)
  {
    if (currentTime - startTime >= 2000)
    {
      // ------------------------------------------------
      // LCD
      // ------------------------------------------------

      lcd.clear();

      lcd.setCursor(0, 0);
      lcd.print("MODULE 4");

      lcd.setCursor(0, 1);
      lcd.print("TEST COMPLETE");

      // ------------------------------------------------
      // SERIAL
      // ------------------------------------------------

      Serial.println();
      Serial.println("==============================");
      Serial.println("TEST COMPLETE");
      Serial.println("==============================");

      stage = 4;
    }
  }

  // ==================================================
  // STAGE 4
  // ==================================================

  else if (stage == 4)
  {
    // Finished
  }
}
