#include <Arduino.h>
#include <LiquidCrystal.h>
#include <EEPROM.h>
#include <avr/io.h>
#include <avr/wdt.h>

/* =====================================================
   LCD CONNECTION
   RS = 8
   EN = 9
   D4 = 4
   D5 = 5
   D6 = 6
   D7 = 7
   ===================================================== */

LiquidCrystal lcd(8, 9, 4, 5, 6, 7);

/* =====================================================
   EEPROM
   ===================================================== */

#define FAULT_ADDR 0

#define SENSOR_FAULT 101

/* =====================================================
   RESET FLAG STORAGE
   ===================================================== */

/*
   MCUSR = MCU Status Register.

   We save MCUSR before normal Arduino startup
   can modify it.
*/

uint8_t resetCause
    __attribute__((section(".noinit")));

/*
   Optiboot saves the reset flags in R2.
   Save R2 before normal C startup changes it.
*/

uint8_t optibootResetFlag
    __attribute__((section(".noinit")));


/* =====================================================
   CAPTURE OPTIBOOT RESET FLAG
   ===================================================== */

void captureOptibootFlag(void)
    __attribute__((naked))
    __attribute__((used))
    __attribute__((section(".init0")));

void captureOptibootFlag(void)
{
    __asm__ __volatile__(
        "sts %0, r2\n"
        : "=m" (optibootResetFlag)
        :
    );
}


/* =====================================================
   CAPTURE MCUSR
   ===================================================== */

void captureMCUSR(void)
    __attribute__((naked))
    __attribute__((used))
    __attribute__((section(".init3")));

void captureMCUSR(void)
{
    resetCause = MCUSR;

    /*
       Clear reset flags after saving them.
    */
    MCUSR = 0;

    /*
       Disable watchdog immediately.
    */
    wdt_disable();
}


/* =====================================================
   VARIABLES
   ===================================================== */

unsigned long startTime = 0;

byte stage = 0;


/* =====================================================
   SETUP
   ===================================================== */

void setup()
{
    lcd.begin(16, 2);

    Serial.begin(9600);

    /*
       Check actual watchdog reset.

       WDRF = Watchdog System Reset Flag
       WDRF is bit 3 of MCUSR.
    */

    bool watchdogReset = false;

    /*
       Check MCUSR.
    */

    if (resetCause & (1 << WDRF))
    {
        watchdogReset = true;
    }

    /*
       Also check reset flag passed by Optiboot.
    */

    if (optibootResetFlag & (1 << WDRF))
    {
        watchdogReset = true;
    }


    /* =================================================
       WATCHDOG RESET DETECTED
       ================================================= */

    if (watchdogReset)
    {
        int lastFault = 0;

        EEPROM.get(FAULT_ADDR, lastFault);

        /*
           SERIAL OUTPUT
        */

        Serial.println();
        Serial.println("==============================");
        Serial.println("        MODULE 4");
        Serial.println("==============================");
        Serial.println("RESET STATUS");

        Serial.print("MCUSR = 0x");
        Serial.println(resetCause, HEX);

        Serial.print("WDRF = ");

        if (resetCause & (1 << WDRF))
        {
            Serial.println("1");
        }
        else
        {
            Serial.println("1 (Optiboot)");
        }

        Serial.println("Reset Reason: WATCHDOG");

        Serial.print("Last Fault Code: ");
        Serial.println(lastFault);

        /*
           LCD OUTPUT
        */

        lcd.clear();

        lcd.setCursor(0, 0);
        lcd.print("RESET: WATCHDOG");

        lcd.setCursor(0, 1);
        lcd.print("WDRF = 1");

        /*
           Move to next stage.
        */

        startTime = millis();

        stage = 2;
    }


    /* =================================================
       NORMAL POWER-ON
       ================================================= */

    else
    {
        /*
           Save sensor fault.
        */

        EEPROM.put(FAULT_ADDR, SENSOR_FAULT);

        /*
           SERIAL
        */

        Serial.println();
        Serial.println("==============================");
        Serial.println("        MODULE 4");
        Serial.println("==============================");
        Serial.println("RESET STATUS");

        Serial.print("MCUSR = 0x");
        Serial.println(resetCause, HEX);

        Serial.println("WDRF = 0");

        Serial.println("Reset Reason: POWER ON");

        Serial.println("Sensor Fault Detected");

        Serial.println("Saving Fault Code: 101");

        /*
           LCD
        */

        lcd.clear();

        lcd.setCursor(0, 0);
        lcd.print("FAULT SAVED");

        lcd.setCursor(0, 1);
        lcd.print("CODE: 101");

        /*
           Start watchdog sequence.
        */

        startTime = millis();

        stage = 1;
    }
}


/* =====================================================
   LOOP
   ===================================================== */

void loop()
{
    unsigned long currentTime = millis();


    /* =================================================
       STAGE 1
       NORMAL POWER-ON
       ================================================= */

    if (stage == 1)
    {
        /*
           Wait 2 seconds.
           No delay() is used.
        */

        if (currentTime - startTime >= 2000)
        {
            /*
               LCD
            */

            lcd.clear();

            lcd.setCursor(0, 0);
            lcd.print("WATCHDOG");

            lcd.setCursor(0, 1);
            lcd.print("STARTING...");

            /*
               SERIAL
            */

            Serial.println();
            Serial.println("Starting Watchdog");
            Serial.println("Timeout: 1 second");

            Serial.flush();

            /*
               Enable actual ATmega328P watchdog.
            */

            wdt_enable(WDTO_1S);

            /*
               Do not call wdt_reset().

               Watchdog expires automatically.
               ATmega328P performs hardware reset.
            */

            while (1)
            {
            }
        }
    }


    /* =================================================
       STAGE 2
       AFTER WATCHDOG RESET
       ================================================= */

    else if (stage == 2)
    {
        if (currentTime - startTime >= 2000)
        {
            int lastFault = 0;

            EEPROM.get(FAULT_ADDR, lastFault);

            /*
               LCD
            */

            lcd.clear();

            lcd.setCursor(0, 0);
            lcd.print("LAST FAULT:");

            lcd.setCursor(0, 1);
            lcd.print(lastFault);

            /*
               SERIAL
            */

            Serial.print("Last Fault Code: ");
            Serial.println(lastFault);

            startTime = currentTime;

            stage = 3;
        }
    }


    /* =================================================
       STAGE 3
       TEST COMPLETE
       ================================================= */

    else if (stage == 3)
    {
        if (currentTime - startTime >= 2000)
        {
            /*
               LCD
            */

            lcd.clear();

            lcd.setCursor(0, 0);
            lcd.print("MODULE 4");

            lcd.setCursor(0, 1);
            lcd.print("TEST COMPLETE");

            /*
               SERIAL
            */

            Serial.println("TEST COMPLETE");

            stage = 4;
        }
    }


    /* =================================================
       STAGE 4
       FINISHED
       ================================================= */

    else if (stage == 4)
    {
        /*
           Test finished.
        */
    }
}
